# Architecture
BR2_x86_64=y

# Toolchain: glibc (worker binaries built on Ubuntu glibc 2.39 -> need glibc target;
# Buildroot glibc is newer and backward-compatible)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y

# System
BR2_TARGET_GENERIC_HOSTNAME="worker"
BR2_TARGET_GENERIC_ISSUE="SEV-SNP MPI Worker"
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_BASH=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
# Init: busybox (default) - no systemd, keep it minimal

# Filesystem: initramfs (cpio + full + gzip)
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_FULL=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# Userspace kernel headers PINNED to 6.12 (toolchain is built against 6.12).
# Decoupled from the v6.13 kernel image: BR2_KERNEL_HEADERS_6_12 overrides the
# default AS_KERNEL so the strict header check passes (userspace headers <=
# running kernel is fine). Keeps the toolchain cached (no rebuild).
BR2_KERNEL_HEADERS_6_12=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_TOOLCHAIN_HEADERS_LATEST=y
BR2_TOOLCHAIN_HEADERS_AT_LEAST="6.12"

# Rootfs overlay + post-build hook
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_WORKER_PATH)/board/worker/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_WORKER_PATH)/board/worker/post-build.sh"

# Kernel: use Buildroot's tested latest (7.1.x) -- gcc-15 clean.
# (fort pinned v6.12 via git, but the 6.12/6.13 EFI stub FAILS to build with the
# GCC 15 toolchain in Buildroot 2026.08 due to the C23 bool/true/false keyword
# clash; that fix is only in newer kernels. Buildroot's default 7.1.x builds OK.)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_WORKER_PATH)/board/worker/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# OpenSSH server (needed for PRRTE 'plm ssh' to launch prted)
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
